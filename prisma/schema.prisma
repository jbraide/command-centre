generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedTranscriptions SavedTranscription[]
  projects            Project[]
  passwordEntries     PasswordEntry[]
  scripts             Script[]
  keyPrinciples       KeyPrinciple[]
  scriptStyles        ScriptStyle[]
  apiKeys             ApiKey[]
  serviceIntegrations ServiceIntegration[]
  ideas               Idea[]
  creatorPersonas     CreatorPersona[]
  chatSessions        ChatSession[]
  smartLists          SmartList[]
  habits              Habit[]
  reminders           Reminder[]
  focusSessions       FocusSession[]
  memories            Memory[]
}

model SavedTranscription {
  id        String   @id @default(cuid())
  userId    String
  url       String
  title     String
  text      String
  segments  String?
  language  String
  duration  Float?
  createdAt DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  links           ProjectLink[]
  personaExamples PersonaExample[]

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#7fd858")
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED | COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks   Task[]
  notes   Note[]
  links   ProjectLink[]
  scripts Script[]
  ideas   Idea[]

  @@index([userId])
}

model Task {
  id             String    @id @default(cuid())
  projectId      String
  parentId       String?
  title          String
  description    String?
  dueDate        DateTime?
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  completed      Boolean   @default(false)
  sortOrder      Int       @default(0)
  repeatInterval String? // "daily" | "weekly" | "monthly" | "yearly" | "weekdays"
  repeatEndDate  DateTime?
  repeatCount    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Task?      @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]     @relation("TaskSubtasks")
  reminders Reminder[]
  focusSessions FocusSession[]

  @@index([projectId])
  @@index([parentId])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  ideaId    String?
  triggerAt DateTime
  title     String
  note      String?
  fired     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  idea Idea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([triggerAt])
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PasswordEntry {
  id                String   @id @default(cuid())
  userId            String
  website           String
  username          String
  encryptedPassword String // AES-256-GCM ciphertext (base64)
  iv                String // Initialization vector (base64)
  encryptedNotes    String? // Also encrypted (base64)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProjectLink {
  id                   String   @id @default(cuid())
  projectId            String
  url                  String
  title                String?
  description          String?
  savedTranscriptionId String?
  createdAt            DateTime @default(now())

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  savedTranscription SavedTranscription? @relation(fields: [savedTranscriptionId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Script {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  styleId   String?
  projectId String?
  personaId String?
  ideaId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  style   ScriptStyle?    @relation(fields: [styleId], references: [id], onDelete: SetNull)
  project Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  persona CreatorPersona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  idea    Idea?           @relation("GeneratedFromIdea", fields: [ideaId], references: [id], onDelete: SetNull)
  ideas   Idea[]          @relation("ScriptIdeas")

  @@index([userId])
}

model KeyPrinciple {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScriptStyle {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  guidelines  String?
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts Script[]

  @@index([userId])
}

model CreatorPersona {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  colorTag    String   @default("#7fd858")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  examples PersonaExample[]
  lessons  PersonaLesson[]
  scripts  Script[]

  @@index([userId])
}

model PersonaExample {
  id              String   @id @default(cuid())
  personaId       String
  sourceType      String // "manual" | "transcription"
  transcriptionId String?
  content         String
  note            String?
  createdAt       DateTime @default(now())

  persona       CreatorPersona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  transcription SavedTranscription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)

  @@index([personaId])
}

model PersonaLesson {
  id        String   @id @default(cuid())
  personaId String
  title     String
  content   String
  url       String?
  createdAt DateTime @default(now())

  persona CreatorPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId])
}

model ApiKey {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  description        String?
  encryptedKey       String // Client-side encrypted (master password)
  iv                 String // Client-side IV
  serverEncryptedKey String? // Server-side encrypted (for automated API calls)
  serverIv           String? // Server-side IV
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ServiceIntegration {
  id        String   @id @default(cuid())
  userId    String
  service   String
  label     String
  config    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, service])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant" | "tool"
  content   String
  toolCalls String? // JSON array of tool call audit entries
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Idea {
  id              String   @id @default(cuid())
  userId          String
  title           String
  rawNotes        String?
  tags            String? // JSON array stored as string (SQLite compat)
  status          String   @default("raw") // raw | promoted | archived
  linkedProjectId String?
  linkedScriptId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?   @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  script           Script?    @relation("ScriptIdeas", fields: [linkedScriptId], references: [id], onDelete: SetNull)
  generatedScripts Script[]   @relation("GeneratedFromIdea")
  reminders        Reminder[]

  @@index([userId])
  @@index([status])
}

model FocusSession {
  id                 String   @id @default(cuid())
  userId             String
  taskId             String?
  duration           Int      @default(25)  // minutes
  breakDuration      Int      @default(5)   // minutes
  completedPomodoros Int      @default(0)
  startedAt          DateTime
  endedAt            DateTime?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  frequency   String   @default("daily") // daily | weekly | weekdays
  color       String   @default("#7fd858")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime // date only (store as midnight UTC)
  completed Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  category  String?  // "persona" | "business" | "content" | "general"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@index([userId, category])
}

model SmartList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String? // emoji or lucide icon name
  filters   String // JSON: { status?, priority?, projectId?, dueDate?, tags?, search? }
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
